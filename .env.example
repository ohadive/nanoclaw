# WhatsApp adapter
# Set to "true" to enable WhatsApp on first boot without existing auth.
WHATSAPP_ENABLED=
# For pairing-code auth: your phone number, digits only, no + prefix.
WHATSAPP_PHONE_NUMBER=
# Set "true" if the WhatsApp number is dedicated to the assistant (bot does
# not prefix outbound messages with its name).
ASSISTANT_HAS_OWN_NUMBER=

# Slack adapter
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Telegram adapter
TELEGRAM_BOT_TOKEN=

# OpenAI — for voice-note transcription via Whisper
OPENAI_API_KEY=
